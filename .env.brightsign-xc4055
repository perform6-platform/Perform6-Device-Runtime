# BrightSign production build — XC4055 three HDMI outputs (single player)
# Usage: npm run release:zip:xc4055 -- 1.0.22
# Copy to SD card root: autorun.brs + index.html + assets/ + perform6-profile.txt
#
# Wiring: HDMI-1 / HDMI-2 / HDMI-3 → LED screens (SCREEN_1 / SCREEN_2 / SCREEN_3).
# One package drives all three LEDs; deployment logical screens map content per HDMI.

VITE_RUNTIME_MODE=BRIGHTSIGN
VITE_HARDWARE_PROFILE=XC4055
VITE_DEPLOYMENT_TYPE=DISPLAY

# Production API (portal.perform6.com)
VITE_API_BASE_URL=https://portal.perform6.com/api/v1

VITE_HEARTBEAT_INTERVAL_MS=60000
VITE_SYNC_INTERVAL_MS=300000
VITE_PAIRING_POLL_MS=30000
VITE_RUNTIME_VERSION=1.0.22

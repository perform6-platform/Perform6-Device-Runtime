{
  "name": "perform6-touchscreen",
  "version": "1.5.8",
  "private": true,
  "description": "Perform6 BrightSign app — BA-style zones, offline SD play (no on-demand HTTPS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "assert:led-playback": "node scripts/assert-led-playback.mjs",
    "assert:program-led": "node scripts/assert-program-led-command.mjs",
    "assert:production-field": "node scripts/assert-atlas-field-gate.mjs",
    "assert:ota-bootstrap": "node scripts/assert-ota-bootstrap.mjs",
    "assert:clean-card-media": "node scripts/assert-clean-card-media.mjs",
    "assert:xt-ota-candidate": "node scripts/assert-xt-ota-candidate.mjs",
    "assert:playback": "node scripts/assert-led-playback.mjs && node scripts/assert-program-led-command.mjs",
    "release:zip": "node scripts/build-profile-zip.mjs XT2145",
    "release:zip:xt2145": "node scripts/build-profile-zip.mjs XT2145",
    "release:zip:xc4055": "node scripts/build-profile-zip.mjs XC4055",
    "release:zip:hd226": "node scripts/build-profile-zip.mjs HD226",
    "release:zip:all": "node scripts/build-all-profile-zips.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "engines": {
    "node": ">=20"
  }
}

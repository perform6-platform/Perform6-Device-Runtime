# BrightSign production build — XT2145 Touch + LED (dual HDMI)
# Usage: npm run release:zip:xt2145 -- 1.5.21
# Copy to SD card root: autorun.brs + index.html + assets/ + perform6-profile.txt
#
# Wiring: HDMI-1 → Bluefin touch · HDMI-2 → LED program display.

VITE_RUNTIME_MODE=BRIGHTSIGN
VITE_HARDWARE_PROFILE=XT2145
VITE_DEPLOYMENT_TYPE=TOUCH_SCREEN

# Perform6 production API. Keep this aligned with the existing portal route so
# an OTA transition does not depend on an unprovisioned api.perform6.com host.
VITE_API_BASE_URL=https://portal.perform6.com/api/v1

VITE_HEARTBEAT_INTERVAL_MS=60000
VITE_SYNC_INTERVAL_MS=300000
VITE_PAIRING_POLL_MS=30000
VITE_RUNTIME_VERSION=1.5.21
